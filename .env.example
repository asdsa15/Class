# ---------------------------------------------------------------------------
# 课堂专注度分析系统 —— 环境变量示例
# 复制本文件为 .env 后按需修改（.env 属于本机配置，不建议提交到代码仓库）
# ---------------------------------------------------------------------------

# 数据库：正式运行使用 MySQL 8.0 的 class_detection 库
# 请把 <PASSWORD> 替换为本机 MySQL 密码；实际使用的配置文件是 .env（本文件仅为示例）
CLASSROOM_DB_URL=mysql+pymysql://root:<PASSWORD>@127.0.0.1:3306/class_detection?charset=utf8mb4
# 0 = MySQL 不可用时直接报错（推荐，确保系统真正使用 MySQL）
# 1 = MySQL 不可用时临时回退本地 SQLite 文件
CLASSROOM_SQLITE_FALLBACK=0
CLASSROOM_SQLITE_FILE=classroom_attention.db
CLASSROOM_DB_TIMEOUT=5

# 首次启动自动创建的管理员（登录后请及时修改密码）
CLASSROOM_CREATE_ADMIN=1
CLASSROOM_ADMIN_USER=admin
CLASSROOM_ADMIN_PASSWORD=admin123
CLASSROOM_ADMIN_NAME=系统管理员

# 模型与推理
CLASSROOM_MODEL_PATH=models/classroom_behavior.pt
CLASSROOM_CONF=0.25
CLASSROOM_IOU=0.45
CLASSROOM_IMGSZ=640
CLASSROOM_DEVICE=auto

# 登录认证（SECRET_KEY 请自行生成一串随机字符串）
CLASSROOM_SECRET_KEY=please-generate-your-own-random-secret
CLASSROOM_TOKEN_EXPIRE_MINUTES=720

# 服务器
CLASSROOM_HOST=127.0.0.1
CLASSROOM_PORT=8000

# 实时检测 / 视频检测
CLASSROOM_VIDEO_INTERVAL=5
CLASSROOM_REALTIME_RECORD_INTERVAL=5
CLASSROOM_REALTIME_MAX_SIDE=960
